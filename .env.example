# Added automatically when you connect Neon through Vercel's Storage tab.
DATABASE_URL=postgres://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# The password you type to sign in.
APP_PASSWORD=choose-a-long-passphrase

# Long random string for the reminder endpoint (/api/summary/<token>). 24+ characters.
# Generate one with:  openssl rand -hex 24
SUMMARY_TOKEN=

# Optional. Defaults to America/New_York.
APP_TIMEZONE=America/New_York
